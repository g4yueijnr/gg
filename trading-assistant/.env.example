# ===== REQUIRED =====

# Claude API key - get one at https://platform.claude.com (this powers the chat)
ANTHROPIC_API_KEY=

# Which Claude model to use (optional). Default is claude-haiku-4-5: fast and
# very cheap. For a smarter (pricier) chat, set: CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MODEL=claude-haiku-4-5

# ---- Pick ONE of the two Polymarket setups below ----

# OPTION A: Polymarket US (the regulated US app - most US users).
# 1. Verify your identity in the Polymarket US iOS app if you haven't.
# 2. Go to https://polymarket.us/developer and create an API key.
# 3. Copy the Key ID and Secret Key here (the secret is shown only once!).
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# OPTION B: Polymarket global (polymarket.com - non-US / original version).
# Private key: profile picture -> Settings -> Export Private Key.
POLYMARKET_PRIVATE_KEY=
# Your wallet ADDRESS (the 0x... shown on your profile). Public info, not a secret.
POLYMARKET_FUNDER_ADDRESS=
# 1 = signed up with email (most people), 2 = signed up with MetaMask
POLYMARKET_SIGNATURE_TYPE=1

# ===== RECOMMENDED =====

# A password for the web page, so only you can use the assistant.
# REQUIRED if you host this on the internet (Railway, Render, a VPS...).
APP_PASSWORD=

# ===== OPTIONAL SAFETY LIMITS =====

# The assistant will refuse any single order bigger than these:
MAX_ORDER_SIZE_SHARES=10000
MAX_ORDER_COST_USD=1000

# Set to true to simulate orders without sending real ones (good for a first test)
DRY_RUN=false

# PORT=3000
