# ===== REQUIRED =====

# OpenAI API key - get one at https://platform.openai.com/api-keys (this powers the chat)
OPENAI_API_KEY=

# Which OpenAI model to use for the chat (optional)
# OPENAI_MODEL=gpt-5.1

# Your Polymarket wallet's private key.
# In the Polymarket app/site: click your profile picture -> Settings -> Export Private Key.
POLYMARKET_PRIVATE_KEY=

# Your Polymarket wallet ADDRESS (the 0x... address shown on your Polymarket profile,
# the one that holds your USDC). This is public info, not a secret.
POLYMARKET_FUNDER_ADDRESS=

# How your Polymarket account was created:
#   1 = signed up with email (most people)
#   2 = signed up by connecting MetaMask or another browser wallet
POLYMARKET_SIGNATURE_TYPE=1

# ===== RECOMMENDED =====

# A password for the web page, so only you can use the assistant.
# REQUIRED if you host this on the internet (Railway, Render, a VPS...).
APP_PASSWORD=

# ===== OPTIONAL SAFETY LIMITS =====

# The assistant will refuse any single order bigger than these:
MAX_ORDER_SIZE_SHARES=10000
MAX_ORDER_COST_USD=1000

# Set to true to simulate orders without sending real ones (good for a first test)
DRY_RUN=false

# PORT=3000
